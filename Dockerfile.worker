# Work image: the package managers and the job runner that the main process
# starts, one disposable container per job, to update dependency files. It is
# built separately from the main image so that npm, pnpm, Python and uv never
# ship in it. Every base image is pinned by digest and every downloaded
# executable by checksum; nothing is fetched when a job runs.
#
# Tool versions (kept in step with the ARG values below, which the
# capabilities step checks against the installed tools):
#   Node.js 24.21.0 (LTS "Krypton") with its bundled npm 11.19.0
#   pnpm 12.10.1 (native executable; writes lockfileVersion '9.0')
#   Python 3.13.16 with its bundled pip 26.2.1
#   uv 0.13.0

ARG NODE_IMAGE=node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66
ARG PYTHON_IMAGE=python:3.13.16-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168
ARG GO_IMAGE=golang:1.26.4@sha256:f96cc555eb8db430159a3aa6797cd5bae561945b7b0fe7d0e284c63a3b291609

# The job runner: a static binary, cross-compiled on the build host.
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod ./
COPY cmd/kestrelynx-worker ./cmd/kestrelynx-worker
COPY internal/worker ./internal/worker
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/kestrelynx-worker ./cmd/kestrelynx-worker

# pnpm 12 is a native executable published as one npm package per platform.
# The tarballs are pinned by SHA-256 (their SHA-512 matches the registry's
# published integrity value).
FROM scratch AS pnpm-amd64
ADD --checksum=sha256:636abc81221a03b94f0c362bebbf0007dfce977226ad5290afed1fdaa5320aa4 \
    https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-12.10.1.tgz /pnpm.tgz
FROM scratch AS pnpm-arm64
ADD --checksum=sha256:45026cc79a8c5d06c604a4a624198cf96fcad7d9ab960c9a92401a0c97c93388 \
    https://registry.npmjs.org/@pnpm/exe.linux-arm64/-/exe.linux-arm64-12.10.1.tgz /pnpm.tgz

ARG TARGETARCH
FROM pnpm-${TARGETARCH} AS pnpm-tarball

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS pnpm
COPY --from=pnpm-tarball /pnpm.tgz /pnpm.tgz
RUN mkdir /pnpm && tar -xzf /pnpm.tgz -C /pnpm --strip-components=1 package/pnpm && chmod 0755 /pnpm/pnpm

FROM ${NODE_IMAGE} AS node
FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE}
ARG NODE_VERSION=24.21.0
ARG NPM_VERSION=11.19.0
ARG PNPM_VERSION=12.10.1
ARG PYTHON_VERSION=3.13.16
ARG PIP_VERSION=26.2.1
ARG UV_VERSION=0.13.0

LABEL io.kestrelynx.worker.protocol="2"

# Node.js and npm come from the pinned Node image. Corepack and yarn are left
# out so no tool version can be switched or fetched while a job runs.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY --from=pnpm /pnpm/pnpm /usr/local/bin/pnpm
COPY --from=uv /uv /usr/local/bin/uv

# The user and group the job runs as. Nothing in the image's writable layer
# may belong to them or be writable by everyone: a job that writes there would
# fill the host's disk, which has no size limit. The main process mounts
# size-limited tmpfs over /tmp and /home/worker, and puts /work (owned by root,
# read-only to the job) in with the inputs. The directories are created here
# only so the paths exist, owned by root; /tmp, /var/tmp and /run/lock lose
# their world-writable mode for the same reason.
RUN groupadd --gid 10001 worker \
 && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /home/worker --shell /usr/sbin/nologin worker \
 && mkdir /work /home/worker \
 && chmod 0755 /work /home/worker /tmp /var/tmp /run/lock

COPY --from=build /out/kestrelynx-worker /usr/local/libexec/kestrelynx-worker

# A machine-readable table of what this image runs and accepts. It is written
# from the installed tools, so the build fails if they differ from the versions
# pinned above.
RUN python3 - <<'PY'
import json, os, re, subprocess

def out(*cmd):
    return subprocess.run(cmd, check=True, capture_output=True, text=True,
                          env={"PATH": "/usr/local/bin:/usr/bin:/bin"}).stdout.strip()

def expect(label, got, want):
    if got != want:
        raise SystemExit("%s is %s, pinned %s" % (label, got, want))
    return got

env = os.environ
versions = {
    "node": expect("node", out("node", "--version").lstrip("v"), env["NODE_VERSION"]),
    "npm": expect("npm", out("npm", "--version"), env["NPM_VERSION"]),
    "pnpm": expect("pnpm", out("pnpm", "--version"), env["PNPM_VERSION"]),
    "python": expect("python", out("python", "--version").split()[1], env["PYTHON_VERSION"]),
    "pip": expect("pip", re.match(r"pip (\S+)", out("python", "-m", "pip", "--version")).group(1), env["PIP_VERSION"]),
    "uv": expect("uv", out("uv", "--version").split()[1], env["UV_VERSION"]),
}
table = {
    "protocol": 1,
    "runtimes": {"node": versions["node"], "python": versions["python"]},
    "tools": {k: versions[k] for k in ("npm", "pnpm", "pip", "uv")},
    "formats": {
        "npm": {"lockfile": "package-lock.json", "lockfile_versions": [2, 3], "projects": "single"},
        "pnpm": {"lockfile": "pnpm-lock.yaml", "lockfile_versions": ["9.0"], "importers": ["."]},
        "uv": {"lockfile": "uv.lock", "lock_versions": [1], "revisions": [5], "projects": "single",
               "interpreter": "system Python only; requires-python must admit it"},
        "pip": {"file": "requirements.txt", "lines": "pinned name==version, optional --hash"},
    },
    "ops": [
        "npm.relock", "npm.update",
        "pnpm.frozen_check", "pnpm.update", "pnpm.relock",
        "uv.check", "uv.upgrade",
        "pip.dry_run",
    ],
}
os.makedirs("/usr/local/share/kestrelynx-worker", exist_ok=True)
with open("/usr/local/share/kestrelynx-worker/capabilities.json", "w") as f:
    json.dump(table, f, indent=2, sort_keys=True)
    f.write("\n")
PY

# Fail the build if anything in the layer is writable by the job.
RUN found="$(find / -xdev \( -perm -0002 -o -user 10001 -o -group 10001 \) ! -type l -print)" \
 && if [ -n "$found" ]; then echo "writable by the job:" >&2; echo "$found" >&2; exit 1; fi

USER 10001:10001
WORKDIR /
ENTRYPOINT ["/usr/local/libexec/kestrelynx-worker"]
CMD ["run", "/work/job.json"]
